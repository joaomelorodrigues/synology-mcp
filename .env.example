# Only for containers or CI. On a Mac, `synology-mcp setup` keeps secrets in the Keychain and
# settings in ~/.config/synology-mcp/config.json, and none of this is needed.

SYNOLOGY_URL=https://nas.example.com:5001
SYNOLOGY_USERNAME=
SYNOLOGY_PASSWORD=
# The trusted-device token that setup obtains for a 2FA account.
SYNOLOGY_DEVICE_ID=
# Printed by setup. Pins the NAS's certificate.
SYNOLOGY_CERT_FINGERPRINT=
# read, write or admin
SYNOLOGY_TIER=read
SYNOLOGY_ALLOW_POWER=false
# Comma-separated, or "all"
SYNOLOGY_MODULES=all
SYNOLOGY_LOCAL_ROOTS=~/Downloads
# Session name sent at login. DSM refuses names it doesn't know for non-administrators.
SYNOLOGY_SESSION_NAME=webui
SYNOLOGY_PROTECTED_PATHS=

# HTTP transport
SYNOLOGY_MCP_TOKEN=
SYNOLOGY_MCP_ALLOWED_HOSTS=
SYNOLOGY_MCP_ALLOWED_ORIGINS=
